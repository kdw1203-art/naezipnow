# Supabase — supabase.com/dashboard → 프로젝트 → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# 국토교통부 실거래 수집 유형 (선택 · 기본 apartment)
#   apartment  아파트 매매·전월세
#   officetel  오피스텔 매매·전월세
#   rowhouse   연립다세대 매매
# 쉼표로 여러 개. 예) MOLIT_PROPERTY_TYPES=apartment,officetel
#
# 켜기 전에: 유형 하나당 시군구 253개 왕복과 market_transactions 행 수가 그대로
# 늘어난다(DB 용량·ETL 시간에 직접 영향). 지도 필터에 유형 선택이 붙기 전까지는
# 수집만 되고 화면에는 안 나온다 — lib/market/molit-transactions.ts 주석 참고.
# MOLIT_PROPERTY_TYPES=apartment

# [G002] 심각 경보 요약 메일 수신 주소 — RESEND_API_KEY 와 함께 설정해야 발송됨
# (미설정이면 /api/cron/alert-email 이 발송을 건너뛰고 그 사실을 응답에 남긴다)
# 운영 기본 후보는 nuguzip@naver.com (lib/brand/business-info DEFAULT_ADMIN_EMAIL)
ALERT_EMAIL_TO=

# 경보·주간 요약·재방문 메일 발송. re_ 로 시작. 없으면 서비스는 정상, 메일만 쉼.
# RESEND_API_KEY=

# ── [1080] 트래픽 증가 대비 ──────────────────────────────────────────────
# KV(Redis REST) — 속도 제한·AI 일일 상한·뉴스 썸네일 캐시·조회수 버퍼·길찾기 캐시의 백엔드.
# Vercel KV(Upstash) 연결 시 자동으로 들어오는 이름이며, UPSTASH_REDIS_REST_URL/TOKEN 도 같은 뜻으로 읽는다.
# 없으면 전부 프로세스 메모리(인스턴스별)로 떨어진다 — /api/health 의 kv 칸으로 확인.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# AI 요청 사이트 전체 일일 상한(한국 날짜 기준 · 시도 수). 0/미설정 = 상한 없음. 넘으면 503(분석은 규칙 기반 결과로 강등).
# AI_DAILY_REQUEST_BUDGET=2000
# 모델 응답 대기 상한(ms · 기본 90000)
# AI_LLM_TIMEOUT_MS=90000

# 가입 캡차(Cloudflare Turnstile) — 둘을 **함께** 넣는다. 하나만 넣으면 가입이 막힌다(lib/auth/verify-turnstile).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# 뉴스 썸네일 끄기 스위치 — 1 이면 /api/town/news/thumb 가 전부 404(아이콘 칸). 매체·저작권 문제 시 배포 없이 끈다.
# NEWS_THUMB_DISABLED=0

# 네이버 길찾기(Directions) 사이트 전체 일일 호출 상한(기본 3000) — 넘으면 직선거리 추정으로.
# NAVER_DIRECTIONS_DAILY_CAP=3000

# 방문 이벤트 원본 행 보존 일수(기본 90) — page_view_events · web_vitals. 집계 표는 그대로.
# TRAFFIC_RETENTION_DAYS=90
